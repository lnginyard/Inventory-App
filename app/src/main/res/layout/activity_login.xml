<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/loginScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/inventory_background"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/loginRootLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- App Brand Logo -->
        <ImageView
            android:id="@+id/imageViewAppLogo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="InventoryGuard Logo"
            android:src="@drawable/img_inventory_logo_1786950932542" />

        <TextView
            android:id="@+id/appTitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/login_title"
            android:textColor="@color/inventory_primary_dark"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/appSubtitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/login_subtitle"
            android:textColor="@color/inventory_muted"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/loginCardLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@color/inventory_card"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="22dp">

            <EditText
                android:id="@+id/editTextUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/username_hint"
                android:inputType="textPersonName"
                android:minHeight="48dp"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/inventory_text"
                android:textColorHint="@color/inventory_muted" />

            <EditText
                android:id="@+id/editTextPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="@string/password_hint"
                android:inputType="textPassword"
                android:minHeight="48dp"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/inventory_text"
                android:textColorHint="@color/inventory_muted" />

            <Button
                android:id="@+id/buttonLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:backgroundTint="@color/inventory_primary"
                android:minHeight="48dp"
                android:text="@string/login_button"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/buttonCreateAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/inventory_accent"
                android:minHeight="48dp"
                android:text="@string/create_account_button"
                android:textColor="@android:color/white" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
